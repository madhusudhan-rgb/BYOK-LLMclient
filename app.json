{
  "expo": {
    "name": "AIchatbots",
    "slug": "MyApp",
    "version": "1.2.0",
    "orientation": "portrait",

    "icon": "./assets/images/icon.png",

    "scheme": "myapp",
    "userInterfaceStyle": "automatic",

    "ios": {
      "bundleIdentifier": "com.madhusudhant.myapp",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
      "package": "com.madhusudhant.myapp",
      "permissions": [],
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

"plugins": [
       "expo-router",
       [
         "expo-splash-screen",
         {
           "image": "./assets/images/icon.png",
           "resizeMode": "contain",
           "backgroundColor": "#ffffff"
         }
       ],
       "expo-font",
       "expo-image",
       "expo-image-picker",
       "expo-web-browser"
      ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "40b4447f-9b4e-4aaf-a32f-5db8dbe16c58"
      }
    }
  }
}