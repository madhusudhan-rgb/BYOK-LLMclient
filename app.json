{
  "expo": {
    "name": "AIchatbots",
    "slug": "MyApp",
    "version": "1.5.0",
    "orientation": "portrait",

    "icon": "./assets/images/icon.png",

    "scheme": "myapp",
    "userInterfaceStyle": "automatic",

    "ios": {
      "bundleIdentifier": "com.madhusudhant.myapp",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
      "package": "com.madhusudhant.myapp",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

"plugins": [
        "expo-router",
        "expo-font",
        "expo-image",
        "expo-image-picker",
        "expo-web-browser"
       ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "40b4447f-9b4e-4aaf-a32f-5db8dbe16c58"
      }
    }
  }
}