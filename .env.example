# Copy this file to .env and fill in your own values.

# OpenRouter API Keys (for Nemotron and Qwen bots)
OPENROUTER_API_KEY_1=your-openrouter-key-1
OPENROUTER_API_KEY_2=your-openrouter-key-2

# Groq API Keys (for GPT-OSS and Llama bots)
GROQ_API_KEY_1=your-groq-api-key-1
GROQ_API_KEY_2=your-groq-api-key-2

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key
